# Generation provider: openai_compatible | openai | anthropic
LLM_PROVIDER=openai_compatible
LLM_MODEL=Qwen/Qwen3.5-9B
LLM_BASE_URL=http://127.0.0.1:8050/v1
LLM_API_KEY=local

# Optional two-tier model pool used by later routing experiments. When blank,
# both roles fall back to LLM_MODEL.
LLM_MODEL_FAST=
LLM_MODEL_STRONG=

LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=300
MAX_NEW_TOKENS=256
MAX_HISTORY_TURNS=4
MAX_SEARCH_STEPS=3

# The query encoder must match data/index/metadata.json. Changing it requires
# a separately-built compatible index; runtime never re-ingests automatically.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
EMBEDDING_THREADS=1
TOP_K=5
EVALUATION_RETRIEVAL_K=10
MIN_RETRIEVAL_SCORE=0.50
INDEX_DIR=techcombank_rag/data/index/a31_semantic_multirepr/all
XROUTER_ENABLED=false
XROUTER_TYPE=rule_based
XROUTER_CONFIG=techcombank_rag/config/xrouter_b1a.json
XROUTER_CONFIDENCE_THRESHOLD=
XROUTER_LOG_PATH=techcombank_rag/data/evaluation/router/b1a-router.jsonl
# B1b only. All values fall back to the matching LLM_* value when omitted.
# A dedicated logical port separates router traffic without requiring graders
# to load a second copy of the model weights.
ROUTER_LLM_PROVIDER=openai_compatible
ROUTER_LLM_BASE_URL=http://127.0.0.1:8001/v1
ROUTER_LLM_MODEL=Qwen/Qwen3.5-9B
ROUTER_LLM_API_KEY=local
ROUTER_LLM_TEMPERATURE=0
ROUTER_LLM_TIMEOUT_SECONDS=90
ROUTER_LLM_MAX_NEW_TOKENS=128
NARRATIVE_INDEX_DIR=techcombank_rag/data/index/b1a_narrative_index
STRUCTURED_INDEX_DIR=techcombank_rag/data/index/a2_paddleocr_vl_1_6_layout_aware
MULTI_REPR_INDEX_DIR=techcombank_rag/data/index/a3_paddleocr_vl_1_6_multigranularity

# B2 adaptive retrieval. All flags are independent; keep all false to reproduce B1.
B2_ENABLED=false
ENABLE_AUTO_SEARCH=false
ENABLE_PAGE_DEDUP=false
ENABLE_DIVERSITY_SELECTION=false
B2_INITIAL_TOP_K=20
B2_SECOND_ROUND_TOP_K=12
B2_MAX_SEARCH_ROUNDS=2
B2_MAX_PER_PAGE=2
B2_PAGE_SIMILARITY_THRESHOLD=0.88
B2_FINAL_K=6
B2_MAX_EVIDENCE_TOKENS=5000
B2_DIVERSITY_LAMBDA=0.70
B2_LOG_PATH=techcombank_rag/data/evaluation/router/b2-search.jsonl
QUERY_EMBEDDING_CACHE_SIZE=128
A31_INDEX_ROOT=techcombank_rag/data/index/a31_semantic_multirepr
A31_PARENT_CHARACTERS=1800

# B3 HyDE retrieval. Disabled by default; hypothetical text is never answer evidence.
ENABLE_HYDE=false
HYDE_MODE=fusion
HYDE_PROMPT_VARIANT=finance_safe
HYDE_CONFIG=techcombank_rag/config/hyde.json
HYDE_PROVIDER=openai_compatible
HYDE_MODEL=
HYDE_BASE_URL=
HYDE_API_KEY=
HYDE_TEMPERATURE=0
HYDE_TIMEOUT_SECONDS=60
HYDE_MAX_TOKENS=180
HYDE_CANDIDATE_K=20
HYDE_RRF_K=60
HYDE_ORIGINAL_WEIGHT=0.5
HYDE_HYPOTHETICAL_WEIGHT=0.5
HYDE_CACHE_SIZE=128
HYDE_LOG_PATH=techcombank_rag/data/evaluation/router/hyde.jsonl

# B4 sparse+dense retrieval. off | bm25 | hybrid | finance_rerank | cross_encoder
B4_RETRIEVAL_MODE=hybrid
B4_CONFIG=techcombank_rag/config/b4_retrieval.json
B4_BM25_ARTIFACT=techcombank_rag/data/index/a31_semantic_multirepr/all/bm25.json.gz
B4_FROZEN_INDEX_DIR=techcombank_rag/data/index/a31_semantic_multirepr/all
B4_FROZEN_CONFIG=techcombank_rag/config/b4_retrieval.json
B4_CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3
B4_CROSS_ENCODER_DEVICE=cpu
B4_CROSS_ENCODER_BATCH_SIZE=8
B4_CROSS_ENCODER_MAX_LENGTH=512
B4_CROSS_ENCODER_THREADS=8

# B5 bounded tool-calling agent. Requires B4_RETRIEVAL_MODE=hybrid.
B5_AGENT_ENABLED=false
B5_AGENT_CONFIG=techcombank_rag/config/b5_tool_agent.json
B5_AGENT_LOG_PATH=techcombank_rag/data/evaluation/router/b5-agent.jsonl
PROCESSED_DIR=techcombank_rag/data/processed
EVALUATION_DIR=techcombank_rag/data/evaluation
DEBUG=false

# Optional USD per-million-token overrides. Leave blank to use the dated
# built-in pricing snapshot when the model is known; local Qwen is USD 0.
LLM_INPUT_PRICE_PER_MILLION=
LLM_CACHED_INPUT_PRICE_PER_MILLION=
LLM_CACHE_WRITE_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=

# Optional local Qwen server settings. These are never required when using an
# external API or an already-running OpenAI-compatible endpoint.
QWEN_MODEL_PATH=
QWEN_PYTHON=python3
QWEN_DEPS=
QWEN_GPU_IDS=
QWEN_MAX_MEMORY_GIB=22
