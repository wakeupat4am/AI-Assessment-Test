# Backward-compatible project-local example. Prefer copying ../.env.example to
# ../.env and using the root Makefile.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://127.0.0.1:8050/v1
LLM_MODEL=Qwen/Qwen3.5-9B
LLM_API_KEY=local
LLM_MODEL_FAST=
LLM_MODEL_STRONG=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=300
MAX_NEW_TOKENS=256
MAX_HISTORY_TURNS=4
MAX_SEARCH_STEPS=3

XROUTER_ENABLED=false
XROUTER_TYPE=rule_based
XROUTER_CONFIG=config/xrouter_b1a.json
XROUTER_CONFIDENCE_THRESHOLD=
XROUTER_LOG_PATH=data/evaluation/router/b1a-router.jsonl
ROUTER_LLM_PROVIDER=openai_compatible
ROUTER_LLM_BASE_URL=http://127.0.0.1:8001/v1
ROUTER_LLM_MODEL=Qwen/Qwen3.5-9B
ROUTER_LLM_API_KEY=local
ROUTER_LLM_TEMPERATURE=0
ROUTER_LLM_TIMEOUT_SECONDS=90
ROUTER_LLM_MAX_NEW_TOKENS=128
NARRATIVE_INDEX_DIR=data/index/b1a_narrative_index
STRUCTURED_INDEX_DIR=data/index/a2_paddleocr_vl_1_6_layout_aware
MULTI_REPR_INDEX_DIR=data/index/a3_paddleocr_vl_1_6_multigranularity
B2_ENABLED=false
ENABLE_AUTO_SEARCH=false
ENABLE_PAGE_DEDUP=false
ENABLE_DIVERSITY_SELECTION=false
B2_INITIAL_TOP_K=20
B2_SECOND_ROUND_TOP_K=12
B2_MAX_SEARCH_ROUNDS=2
B2_MAX_PER_PAGE=2
B2_PAGE_SIMILARITY_THRESHOLD=0.88
B2_FINAL_K=6
B2_MAX_EVIDENCE_TOKENS=5000
B2_DIVERSITY_LAMBDA=0.70
B2_LOG_PATH=data/evaluation/router/b2-search.jsonl
QUERY_EMBEDDING_CACHE_SIZE=128
A31_INDEX_ROOT=data/index/a31_semantic_multirepr
A31_PARENT_CHARACTERS=1800

# B3 HyDE retrieval. Disabled by default.
ENABLE_HYDE=false
HYDE_MODE=fusion
HYDE_PROMPT_VARIANT=finance_safe
HYDE_CONFIG=config/hyde.json
HYDE_PROVIDER=openai_compatible
HYDE_MODEL=
HYDE_BASE_URL=
HYDE_API_KEY=
HYDE_TEMPERATURE=0
HYDE_TIMEOUT_SECONDS=60
HYDE_MAX_TOKENS=180
HYDE_CANDIDATE_K=20
HYDE_RRF_K=60
HYDE_ORIGINAL_WEIGHT=0.5
HYDE_HYPOTHETICAL_WEIGHT=0.5
HYDE_CACHE_SIZE=128
HYDE_LOG_PATH=data/evaluation/router/hyde.jsonl

# B4 sparse+dense retrieval. off | bm25 | hybrid | finance_rerank | cross_encoder
B4_RETRIEVAL_MODE=off
B4_CONFIG=config/b4_retrieval.json
B4_BM25_ARTIFACT=data/index/a31_semantic_multirepr/all/bm25.json.gz
B4_CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3
B4_CROSS_ENCODER_DEVICE=cpu
B4_CROSS_ENCODER_BATCH_SIZE=8
B4_CROSS_ENCODER_MAX_LENGTH=512
B4_CROSS_ENCODER_THREADS=8

# B5 bounded tool-calling agent. Requires B4_RETRIEVAL_MODE=hybrid.
B5_AGENT_ENABLED=false
B5_AGENT_CONFIG=config/b5_tool_agent.json
B5_AGENT_LOG_PATH=data/evaluation/router/b5-agent.jsonl

QWEN_MODEL_PATH=
QWEN_PYTHON=python3
QWEN_DEPS=
QWEN_GPU_IDS=
QWEN_MAX_MEMORY_GIB=22

EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
EMBEDDING_THREADS=1
TOP_K=5
EVALUATION_RETRIEVAL_K=10
MIN_RETRIEVAL_SCORE=0.50
INDEX_DIR=techcombank_rag/data/index
PROCESSED_DIR=techcombank_rag/data/processed
EVALUATION_DIR=techcombank_rag/data/evaluation
DEBUG=false

LLM_INPUT_PRICE_PER_MILLION=
LLM_CACHED_INPUT_PRICE_PER_MILLION=
LLM_CACHE_WRITE_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=
